bool dc_recurse (unsigned int depth, MASK_PROTO (a_mask), MASK_PROTO (a_img_mask),
	    MASK_PROTO (binv_mask), MASK_PROTO (binv_img_mask), MASK_PROTO (c_mask));

/* Guess gamma.  */
bool
dc_recurse3 (unsigned int depth, MASK_PROTO (a_mask), MASK_PROTO (a_img_mask),
	     MASK_PROTO (binv_mask), MASK_PROTO (binv_img_mask), MASK_PROTO (c_mask))
{
  unsigned int res;

  /* unlike alpha and beta, gamma is affine left-refined.  So we could
     infer the mask from depth.  But we want to share code, so we don't.  */

  res = binv[sbox[a[depth]]];

  /* First case: c[depth] is already defined.  Then check if we
     found a result, have to keep looking, or can bounce.  */
  if (MASK_TEST (c_mask, depth))
    {
      res = galois_add (res, c[depth]);

      if (res != tbox[depth])
	return 0;
      else if (depth == sbox_defined - 1)
	return report_success (depth, MASK_INV (a_mask), MASK_INV (a_img_mask),
			       MASK_INV (binv_mask), MASK_INV (binv_img_mask), MASK_INV (c_mask));
      else
	return dc_recurse (depth + 1, MASK_INV (a_mask), MASK_INV (a_img_mask),
			   MASK_INV (binv_mask), MASK_INV (binv_img_mask), MASK_INV (c_mask));
    }  
  else
    {
      MASK_DECL (new_c_mask);
      gf2n_t i;
      gf2n_t cval = galois_add (res, tbox[depth]);

      MASK_COPY (new_c_mask, c_mask);

      /* A guess means that we set c[depth] = cval, and then follow
	 the implications of this guess.  */
      c[depth] = cval;

      MASK_SET (new_c_mask, depth);

      for (i = 1; i < TWO_POW_N; i++)
	{
	  if (MASK_TEST (c_mask, i))
	    {
	      unsigned int nidx;
	      unsigned int nimg;
	      
	      /* At this point, we know that c[0] is already defined!  */
	      nidx = galois_add (depth, i);
	      nimg = galois_add (c[0], galois_add (cval, c[i]));
	      c[nidx] = nimg;
	      MASK_SET (new_c_mask, nidx);
	    }
	}

      if (depth == sbox_defined - 1)
	return report_success (depth, MASK_INV (a_mask), MASK_INV (a_img_mask),
			       MASK_INV (binv_mask), MASK_INV (binv_img_mask),
			       MASK_INV (new_c_mask));
      else
	return dc_recurse (depth + 1, MASK_INV (a_mask), MASK_INV (a_img_mask),
			   MASK_INV (binv_mask), MASK_INV (binv_img_mask),
			   MASK_INV (new_c_mask));
    }
  return false;
}

bool
verify_binv (int depth, int bdepth, MASK_PROTO (binv_mask))
{
  /* It suffices to test beta linear, the constant is swallowed up by gamma.  */
  if (depth == 0 && bdepth != 0)
    return true;

  return false;
}

/* Guess binv[depth].  */
bool
dc_recurse2 (unsigned int depth, MASK_PROTO (a_mask), MASK_PROTO (a_img_mask),
	     MASK_PROTO (binv_mask), MASK_PROTO (binv_img_mask), MASK_PROTO (c_mask))
{
  unsigned int idx;
  unsigned int bidx;

  idx = sbox[a[depth]];

  /* First case: binv[idx] is already defined.  Then check if we
     found a result, have to keep looking, or can bounce.  */
  /* FIX: If yes, just pass on to gamma.  */
  if (MASK_TEST (binv_mask, idx))
    return dc_recurse3 (depth, MASK_INV (a_mask), MASK_INV (a_img_mask),
			MASK_INV (binv_mask), MASK_INV (binv_img_mask), MASK_INV (c_mask));

  /* Second case: binv[idx] is not defined.  We guess a value that is
     linear independent of all the other values for binv, and that is
     between 0 and s[depth].  If we can set it to a value smaller than
     s[depth], we are done!  */
  /* FIX: We guess a value that is between 0 and 2^n-1 and fix it up
     by gamma.  */
  for (bidx = 0; bidx < TWO_POW_N; bidx++)
    {
      unsigned int i;
      MASK_DECL (new_binv_mask);
      MASK_DECL (new_binv_img_mask);

      if (MASK_TEST (binv_img_mask, bidx))
	continue;
      if (verify_binv (idx, bidx, binv_mask))
	continue;

      MASK_COPY (new_binv_mask, binv_mask);
      MASK_COPY (new_binv_img_mask, binv_img_mask);

      /* A guess means that we set binv[idx] = bidx, and then follow
	 the implications of this guess.  */
      binv[idx] = bidx;
      MASK_SET (new_binv_mask, idx);
      MASK_SET (new_binv_img_mask, bidx);
      /* FIXME: Can be optimized by lowest bit search and clearing
	 bits with the inverse of the mask!  */
      /* binv[0] is not necessarily defined.  Thus, we take the first
	 value we can get.  The others follow then by the equation:
	 binv[x + y + c] = binv[x] + binv[y] + binv[c].  */
      for (i = 0; i < TWO_POW_N; i++)
	if (MASK_TEST (binv_mask, i))
	  break;
      if (i != TWO_POW_N)
	{
	  gf2n_t c = i++;
	  gf2n_t binvc = binv[c];

	  while (i < TWO_POW_N)
	    {
	      unsigned int nidx = galois_add (c, galois_add (idx, i));
	      unsigned int nimg;

	      if (MASK_TEST (binv_mask, i))
		{
		  nimg = galois_add (binvc, galois_add (bidx, binv[i]));

		  if (verify_binv (nidx, nimg, new_binv_mask))
		    break;

		  binv[nidx] = nimg;
		  MASK_SET (new_binv_mask, nidx);
		  MASK_SET (new_binv_img_mask, nimg);
		}

	      i++;
	    }
	  if (i != TWO_POW_N)
	    continue;
	}

      /* FIX: Just pass on to gamma.  */
      if (dc_recurse3 (depth, MASK_INV (a_mask), MASK_INV (a_img_mask),
		       MASK_INV (new_binv_mask), MASK_INV (new_binv_img_mask),
		       MASK_INV (c_mask)) == true)
	return true;
    }
  return false;
}


