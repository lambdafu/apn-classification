static int found;

/* Guess a[depth].  */
bool
dc_recurse (unsigned int depth, MASK_PROTO (a_mask), MASK_PROTO (a_img_mask),
	    MASK_PROTO (binv_mask), MASK_PROTO (binv_img_mask), MASK_PROTO (c_mask))
{
  int adepth;

#if 0
  if (count == 0)
    {
      if (depth > 0)
	report (depth - 1, MASK_INV (a_mask), MASK_INV (a_img_mask),
		MASK_INV (binv_mask), MASK_INV (binv_img_mask), MASK_INV (c_mask));
      count = COUNT;
    }
  else
    count--;
#endif

  /* First case: a[depth] was already defined in a previous step (by
     linear dependence).  In this case, just skip over to the guess
     for binv.  */
  if (MASK_TEST (a_mask, depth))
    {
      /* If sbox[a[depth]] happens to be indeterminate, we have to
	 bounce here.  */
      if (a[depth] >= sbox_defined)
	return 0;

      return dc_recurse2 (depth, MASK_INV (a_mask), MASK_INV (a_img_mask),
			  MASK_INV (binv_mask), MASK_INV (binv_img_mask), MASK_INV (c_mask));
    }

  /* Second case: a[depth] is not defined yet.  We guess it as
     anything that's not cleared in a_img_mask but is between 0 and
     sbox_defined-1 (inclusive).  */
  for (adepth = 0; adepth < sbox_defined; adepth++)
    {
      int i;
      MASK_DECL (new_a_mask);
      MASK_DECL (new_a_img_mask);

      if (MASK_TEST (a_img_mask, adepth))
	continue;

      if (verify_a (depth, adepth))
	continue;
	
      MASK_COPY (new_a_mask, a_mask);
      MASK_COPY (new_a_img_mask, a_img_mask);

      /* A guess means that we set a[depth] = adepth, and then follow
	 the implications of this guess up to binv.  */
      a[depth] = adepth;
      MASK_SET (new_a_mask, depth);
      MASK_SET (new_a_img_mask, adepth);
      /* FIXME: Can be optimized by lowest bit search and clearing
	 bits with the inverse of the mask!  */
      for (i = 1; i < TWO_POW_N; i++)
	{
	  if (MASK_TEST (a_mask, i))
	    {
	      unsigned int nidx;
	      unsigned int nimg;

	      /* At this point, we know that a[0] is already defined!
		 Because we have _some_ values set, and a[0] is the
		 first one to be defined.  */
	      nidx = galois_add (depth, i);
	      nimg = galois_add (a[0], galois_add (adepth, a[i]));

	      if (verify_a (nidx, nimg))
		break;

	      a[nidx] = nimg;
	      MASK_SET (new_a_mask, nidx);
	      MASK_SET (new_a_img_mask, nimg);
	    }
	}
      if (i != TWO_POW_N)
	continue;

      if (dc_recurse2 (depth, MASK_INV (new_a_mask), MASK_INV (new_a_img_mask),
		       MASK_INV (binv_mask), MASK_INV (binv_img_mask), MASK_INV (c_mask)))
	//	  return true;
	{
	  // Keep going;
	  found++;
	}
    }

  return false;
}

